{
  "name": "pstack-dsh",
  "description": "DeepSeek Harness port of official pstack. Playbooks and principles are poteto's; only the harness call layer is rewritten.",
  "version": "0.3.1",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "src",
    "skills",
    "agents",
    "cordis.patch.yml",
    "cordis.yml",
    "dshx.yml",
    "HARNESS.md",
    "README.md",
    "TEST-PLAN.md",
    "LICENSE",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test tests/*.spec.ts",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": "^22.19.0 || >=24",
    "dsh": ">=0.2.1-rc.1 <0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anrahya/pstack-dsh.git"
  },
  "homepage": "https://github.com/Anrahya/pstack-dsh",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "pstack",
    "poteto-mode"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-atomic-write": ">=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-skill": ">=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-util-values": ">=0.2.1-rc.1 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-atomic-write": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-atomic-write": "0.2.1-rc.3",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/dsh-util-values": "0.2.1-rc.3",
    "@types/node": "^22.20.0",
    "@types/semver": "^7.7.0",
    "semver": "^7.7.2",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
